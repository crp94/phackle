{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true
  },
  // GR6 gr6-117: `scripts` was absent, so `npm run typecheck` never saw
  // `gen_goldens.ts` or `simulate_calibration.ts` — the two generators of
  // COMMITTED artifacts (`tests/determinism/fixtures/*.json`,
  // `src/data/p_hit_by_k.json`). A type error in either would have surfaced
  // only as a broken artifact. The `.mjs` half of gr6-117 (lint coverage for
  // `scripts/generate-pwa-images.mjs`) belongs to eslint.config.js.
  "include": ["src", "tests", "e2e", "scripts", "vite.config.ts", "playwright.config.ts"]
}
