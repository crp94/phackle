# GR6 gr6-056 — THE WRONG NODE USED TO FAIL 270 TESTS WITH AN UNRELATED-LOOKING
# ERROR.
#
# The review lane's first gate run used the machine's default PATH node
# (v25.4.0) and got `TypeError: window.localStorage.clear is not a function`
# across 12 test files — 270 red assertions, none of which named the actual
# cause. On the pinned runtime the same tree is 1494/1494. The requirement was
# recorded only in `.nvmrc`, which nothing but `actions/setup-node` reads.
#
# `engine-strict` turns that into a legible failure at INSTALL time, naming the
# package and the range, before a single test has run.
#
# MEASURED CONSEQUENCE, stated because it will surprise someone. `engine-strict`
# applies to dependencies too, and `jsdom@30.0.1` requires
# `^22.22.2 || ^24.15.0 || >=26.0.0`. On Node **22.22.1** — one patch below that
# floor, and a version that runs the whole suite green today — `npm ci` now
# stops with `EBADENGINE … jsdom@30.0.1`. That is correct rather than
# unfortunate: 22.22.1 was already emitting EBADENGINE as a warning on every
# install, i.e. the tree's dependency graph has said "unsupported" all along and
# nothing was listening. `nvm use` reads `.nvmrc`'s `22` and resolves to the
# latest 22.x, which clears the floor; CI does the same through
# `actions/setup-node`. See README's Development section.
engine-strict=true
